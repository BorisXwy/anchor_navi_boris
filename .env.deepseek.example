# Optional fallback credentials file (copy to .env.deepseek and fill in).
# The primary configuration lives in local_env.sh (see local_env.sh.example):
# OPENROUTER_API_KEY / OPENROUTER_API_URL / NAVI_OPENROUTER_MODEL take
# precedence over the DEEPSEEK_* names below. Values here are only used when
# the relay names are absent from the environment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://www.dmxapi.cn/v1
DEEPSEEK_VLM_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_THINKING=disabled
